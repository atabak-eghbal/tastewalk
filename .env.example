# --- Qloo (hackathon API) ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# --- LLM (any OpenAI-compatible provider). Default: Groq free tier (console.groq.com) ---
# Gemini also works: https://generativelanguage.googleapis.com/v1beta/openai/ + gemini-2.5-flash
# (its free tier is only 20 requests/day).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# --- Maps / routing (optional) ---
ROUTING_BASE_URL=https://router.project-osrm.org
# --- Guardrails ---
MAX_STOPS=6
CACHE_DIR=.cache
